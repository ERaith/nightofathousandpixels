# Production Environment Variables for AWS Deployment

# Database - PostgreSQL (required for production)
DATABASE_URL="postgresql://username:password@your-rds-endpoint:5432/nightofpixels"

# Site configuration
NEXT_PUBLIC_SITE_NAME="Night of a Thousand Pixels"
ORIGIN="https://your-domain.com"  # Your actual domain or EC2/ECS public URL

# Security - Used for JWT session tokens - CHANGE THIS!
COOKIE_SECRET="your-secure-32-char-minimum-secret-here"

# Optional: YouTube Data API v3 for video search
YOUTUBE_API_KEY=""

# Node environment
NODE_ENV="production"
