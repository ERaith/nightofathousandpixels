package templates

import "github.com/ERaith/nightofathousandpixels/internal/web/viewmodel"

// SlatePage is the board: every live submission for a season, and what this
// particular viewer can do about it.
//
// One template serves all four season states, because a draft season and an
// empty October morning are not different pages — they are this page with no
// movies on it. See EmptySlate, which is the state most people will see most
// often and the one that has to look deliberate.
//
// Nothing here decides anything. Whether to offer the submit control is
// SlatePage.CanSubmit, which the handler worked out from the season window,
// membership and the quota together. When it is false there is no control at
// all rather than a disabled one: a button that exists in order to be refused
// is worse than no button, and on a touch screen it is not even obviously
// refused.
//
// The words are the theme pack's, through p.Layout.Text; the numbers, dates and
// names are the view model's. "6 films on the board" is one of each: the 6 is
// counted here and the noun is Portal's or Elvira's.
templ SlatePage(p Slate) {
	@Layout(p.Layout) {
		<div class="page-head measure">
			if label := p.Layout.SeasonStateLabel(p.Season.State); label != "" {
				<p class="badge badge--accent">{ label }</p>
			}
			<h1>{ slateHeading(p.Layout.Theme, p.Season) }</h1>
			if summary := p.Layout.SeasonStateSummary(p.Season.State); summary != "" {
				<p class="lead">{ summary }</p>
			}
		</div>
		if p.Result != nil {
			@SeasonOutcome(p.Layout.Theme, *p.Result)
		}
		// A tallied season is already dated by the outcome above, and in
		// practice locked_at and tallied_at are minutes apart. Printing
		// "Locked" under "Counted" with what looks like the same timestamp in
		// both reads as a glitch rather than as two facts.
		if p.Result == nil {
			@SeasonStrip(p)
		}
		// An empty board carries its own invitation, so the action strip
		// stands down for it. Two primary buttons a thumb apart, both going
		// to the same place, is not twice the invitation — it reads as a page
		// that was assembled rather than written.
		if p.HasMovies() {
			@SlateActions(p)
		}
		<section>
			if p.HasMovies() {
				<h2>
					{ p.Layout.Text(viewmodel.KeySlateCountHeading,
						viewmodel.PlaceholderCount,
						p.Layout.Count(p.MovieCount(), viewmodel.KeyFilmOne, viewmodel.KeyFilmMany)) }
				</h2>
				if p.ShowingHidden {
					// An admin list that quietly contains withdrawn films,
					// with no note that it does, is how a hidden film gets
					// believed to be public.
					<div class="notice notice--warn" role="status">
						<p class="mb-0">
							<strong>{ p.Layout.Text(viewmodel.KeySlateHiddenLede) }</strong>
							{ " " }
							{ p.Layout.Text(viewmodel.KeySlateHiddenBody) }
						</p>
					</div>
				}
				<ul class="card-grid">
					for _, movie := range p.Movies {
						@MovieCardItem(p.Layout.Theme, movie)
					}
				</ul>
			} else {
				@EmptySlate(p)
			}
		</section>
	}
}

// EmptySlate is the morning of 1 October.
//
// It is the most-seen state of the whole site: the link hits the group chat,
// thirty people open it at once, and there is nothing on the board because
// nobody has submitted yet. A bare "no movies yet" reads as a page that failed
// to load, and the fix for that is not a nicer shade of grey — it is naming
// the thing the visitor is supposed to do and putting it under their thumb.
//
// The button is the same CanSubmit decision as everywhere else. A visitor who
// cannot submit gets the reason and, when they are simply signed out, the way
// in — because "sign in" is the actual next step for most of the people who
// will see this page before they have ever signed in.
//
// This is also the single most valuable thing a pack can rewrite, and the four
// strings below are the ones to look at first when judging one. An empty board
// in the base voice says "Nobody has gone first yet"; Aperture Science says the
// testing track is clear; Elvira dares somebody. Same page, same shape, same
// button under the same thumb.
templ EmptySlate(p Slate) {
	{{ t := p.Layout.Theme }}
	<div class="empty">
		<div class="empty__say">
			<h2 class="mt-0">{ t.Text(viewmodel.KeySlateEmptyHeading) }</h2>
			<p>{ t.Text(viewmodel.KeySlateEmptyBody) }</p>
			if p.CanSubmit && p.SubmitHref != "" {
				<a class="btn btn--primary" href={ p.SubmitHref }>{ t.Text(viewmodel.KeySlateEmptyCTA) }</a>
			} else if p.Layout.SignInHref != "" {
				<a class="btn btn--primary" href={ p.Layout.SignInHref }>{ t.Text(viewmodel.KeySlateEmptySignIn) }</a>
			}
		</div>
		@EmptySlatePreview()
	</div>
}

// EmptySlatePreview is three empty cards in the shape of the real ones.
//
// It is the "something to look at" half of nap-luo, and it is not decoration
// for its own sake: it shows the visitor what the thing they are being asked
// to start actually looks like. Three outlines in the same grid, at the same
// proportions, with the same media box — so the page reads as a board waiting
// to be filled rather than as a page that failed to load, which is what a
// centred paragraph on its own reads as.
//
// aria-hidden and not focusable, because there is nothing in it: a screen
// reader has already been told nobody has gone first, and announcing three
// empty articles after that is noise. It carries no text at all, so there is
// nothing for it to hide.
//
// It has no animation, which is the difference between this and a loading
// skeleton. A skeleton pulses because something is coming; nothing is coming
// here until somebody presses the button.
templ EmptySlatePreview() {
	<div class="slate-preview" aria-hidden="true">
		for range 3 {
			<div class="card card--ghost">
				<span class="ghost ghost--title"></span>
				<span class="ghost ghost--line"></span>
				<div class="card__media"></div>
				<span class="ghost ghost--credit"></span>
			</div>
		}
	</div>
}

// SeasonStrip is the deadline and your own allowance, side by side.
//
// These are the two facts somebody opens the slate to check — when does this
// shut, and have I still got a pick — and until nap-luo they were two separate
// paragraphs a scroll apart, one of them wrapped in a notice box. Putting them
// in one bordered row is the whole change; neither sentence was rewritten.
//
// Both cells are conditional and the strip renders nothing when neither is
// there, rather than an empty bordered box. A season with no dates set is
// real: all four window columns in migration 00002 are nullable. A viewer with
// no quota is real too — that is everybody who is signed out.
templ SeasonStrip(p Slate) {
	{{ date := seasonNextDate(p.Layout.Theme, p.Season) }}
	{{ quota := p.Quota.Label() }}
	if date.Set() || quota != "" {
		<div class="season-strip">
			if date.Set() {
				<div class="season-strip__cell">
					<p class="season-strip__label mb-0">{ date.Label }</p>
					<p class="countdown mb-0">{ date.Value }</p>
				</div>
			}
			if quota != "" {
				<div class="season-strip__cell season-strip__cell--aside">
					<p class="season-strip__label mb-0">Your picks</p>
					<p class="season-strip__value mb-0">{ quota }</p>
				</div>
			}
		</div>
	}
}

// SlateActions is the row between the season and the board: the submit
// control, or the way in, or nothing.
//
// The REASON there is no control is no longer here. It is SubmitQuota.Label,
// it is still written per case rather than shared — "You can vote this year,
// but not put films on the board" for a member whose limit is an explicit
// zero, "You have used all 2 picks for this year" for one who spent them —
// and it now sits in SeasonStrip next to the deadline, because those two are
// the pair of facts somebody opens this page to check. Printing it here as
// well would say it twice; printing it only here made the page three stacked
// paragraphs, which is what nap-luo is about.
//
// A member who cannot submit therefore gets nothing from this template. That
// is deliberate and is not the same as saying nothing: the strip above has
// already said it, in their own sentence.
templ SlateActions(p Slate) {
	if p.CanSubmit && p.SubmitHref != "" {
		<div class="cluster">
			<a class="btn btn--primary" href={ p.SubmitHref }>Put a movie up</a>
		</div>
	} else if p.Quota.Label() == "" && p.Layout.SignInHref != "" {
		// No quota at all and a way in: signed out. A member who simply
		// cannot add to the board has a quota, so they fall past this and
		// get nothing here -- the strip above has already told them why.
		// The films are public to read; adding one is not.
		<div class="cluster">
			<a class="btn btn--ghost" href={ p.Layout.SignInHref }>{ p.Layout.Text(viewmodel.KeySlateSignInCTA) }</a>
			<p class="meta mb-0">{ p.Layout.Text(viewmodel.KeySlateSignInNote) }</p>
		</div>
	}
}

// SeasonOutcome is the result of a locked season.
//
// A tie is a real outcome, not an error: result.winner_movie_id is nullable
// for exactly this case, and the page says so in words rather than showing an
// empty winner. A blank winner title with Tied false would be a bug upstream,
// and it renders as the tie rather than as "The winner: ." — the failure mode
// of being slightly vague beats the failure mode of looking broken.
//
// The winner's title goes through the pack's own sentence rather than being
// concatenated onto it, so a pack can put the film's name where the sentence
// needs it instead of always last.
templ SeasonOutcome(t Theme, r SeasonResult) {
	if r.Tied || r.WinnerTitle == "" {
		<div class="notice notice--warn" role="status">
			<p class="mb-0">
				<strong>{ t.Text(viewmodel.KeyOutcomeTiedLede) }</strong>
				{ " " }
				{ t.Text(viewmodel.KeyOutcomeTiedBody) }
				if label := r.TalliedLabel(); label != "" {
					{ " " + t.Text(viewmodel.KeyOutcomeCounted, viewmodel.PlaceholderDate, label) }
				}
			</p>
		</div>
	} else {
		<div class="notice notice--ok" role="status">
			<p class="mb-0">
				<strong>{ t.Text(viewmodel.KeyOutcomeWinnerLede) }</strong>
				{ " " }
				{ t.Text(viewmodel.KeyOutcomeWinnerBody, viewmodel.PlaceholderTitle, r.WinnerTitle) }
				if label := r.TalliedLabel(); label != "" {
					{ " " + t.Text(viewmodel.KeyOutcomeCounted, viewmodel.PlaceholderDate, label) }
				}
			</p>
		</div>
	}
}
