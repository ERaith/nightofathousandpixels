package templates

import "github.com/ERaith/nightofathousandpixels/internal/web/viewmodel"

// The TMDB picker on the submit page (ticket E10, nap-eie).
//
// ---------------------------------------------------------------------------
// It works with JavaScript switched off. That is the design, not a courtesy.
// ---------------------------------------------------------------------------
//
// The search box is a real <form method="get"> pointing at the submit page,
// and every result is a real <a href>. Press enter with no JavaScript and the
// page reloads with the results on it; click a result and the page reloads
// with the form filled in. htmx's attributes sit on top of exactly that and
// change only WHEN the request happens — as you type, into a fragment, instead
// of on submit, into a whole page. The server renders the same component
// either way, which is why there is one template here and not two.
//
// That is worth the small amount of duplication it costs, because the failure
// mode of the alternative is the one Eraith actually cares about: the picker
// is the only way to submit, and somebody on a phone with a flaky connection
// and a half-loaded script cannot put a film on the board at all.
//
// ---------------------------------------------------------------------------
// Posters are hotlinked to image.tmdb.org, deliberately.
// ---------------------------------------------------------------------------
//
// The alternative is proxying them through this server, and that would be the
// wrong trade here:
//
//   - A proxy that fetches a URL derived from a third-party response is an
//     SSRF surface, and writing one carefully is more security-relevant code
//     than the entire rest of this feature.
//   - It would put every poster byte through a homelab box, for images a CDN
//     already serves from an edge.
//   - The privacy it would buy is small and narrow. These images are only ever
//     requested from the search fragment, which is behind the member gate, by
//     somebody who has just chosen to search TMDB. TMDB learns that a member's
//     IP searched for films — which is, to the byte, what the search request
//     itself already told them.
//
// referrerpolicy="no-referrer" is the part that is not automatic: without it
// the browser sends this site's URL to TMDB's CDN with every thumbnail.
//
// THERE IS NO Content-Security-Policy HEADER ON THIS SITE TODAY. Nothing here
// changes that, and nothing here needed to. But when one is added, this is the
// line it has to account for: img-src must include https://image.tmdb.org, and
// script-src must allow /static/js/htmx.min.js, or the picker goes blank with
// no visible error.

// SearchSection is the whole search half of the submit page: the box, and the
// results container htmx swaps into.
//
// It renders nothing at all when search is unavailable, rather than an
// explanation. A member on a stack with no TMDB key is not waiting for a
// feature — they are trying to put a film on the board, and the four boxes
// below do that. Telling them about a key they cannot set is noise.
templ SearchSection(p Submit) {
	if p.Search.Available && p.Search.Action != "" {
		<div class="measure stack search">
			<form
				class="search__form"
				method="get"
				action={ p.Search.Action }
				role="search"
			>
				<div class="field">
					<label for="submit-search">{ p.Layout.Text(viewmodel.KeySearchLabel) }</label>
					<p class="field__hint mb-0" id="submit-search-hint">{ p.Layout.Text(viewmodel.KeySearchHint) }</p>
					<div class="cluster search__row">
						// The hx-* attributes below are what make this live,
						// and three of them are load-bearing:
						//
						// delay:300ms is what keeps a four-letter word from
						// being four requests. It is about the gap between
						// keystrokes of somebody typing normally, so a word
						// becomes one request at the end of it rather than one
						// per letter.
						//
						// "changed" is what stops arrow keys, modifiers and
						// tabbing from firing a search for text that has not
						// changed.
						//
						// hx-indicator points at the RESULTS, not the input:
						// the region that changes is what should show the busy
						// state, and an input that goes busy while a request is
						// out makes typing stutter.
						<input
							class="search__input"
							type="search"
							id="submit-search"
							name={ viewmodel.FieldQuery }
							value={ p.Search.Query }
							autocomplete="off"
							aria-describedby="submit-search-hint"
							if p.Search.FragmentHref != "" {
								hx-get={ p.Search.FragmentHref }
								hx-trigger="input changed delay:300ms, search"
								hx-target={ "#" + p.Search.ResultsID }
								hx-swap="innerHTML"
								hx-indicator={ "#" + p.Search.ResultsID }
							}
						/>
						// Still here with htmx loaded, and still does the
						// right thing: it submits the form, which navigates to
						// the same search server-side. A search box with no
						// visible way to say "go" is a search box people think
						// is broken.
						<button class="btn btn--primary" type="submit">
							{ p.Layout.Text(viewmodel.KeySearchButton) }
						</button>
					</div>
				</div>
			</form>
			// aria-live so that a screen reader is told the list changed when
			// htmx swaps it in without a page load. Polite, not assertive: it
			// should not interrupt somebody mid-word while they are still
			// typing the title.
			<div
				id={ p.Search.ResultsID }
				class="search__results"
				aria-live="polite"
				aria-busy="false"
			>
				@SearchResults(p.Layout, p.Search)
			</div>
		</div>
	}
}

// SearchResults is the fragment: the list, or the one sentence that replaces
// it. This is what GET /submit/search returns on its own.
//
// The order of the cases is the order they have to be asked in. A failed
// request and an empty result set are both "no list", and telling somebody
// "nothing matches that" when the truth is "we could not ask" sends them off
// to re-type a title that was right the first time.
templ SearchResults(p Page, s viewmodel.SearchState) {
	if s.Failed {
		<p class="notice notice--warning mb-0" role="status">
			{ p.Text(viewmodel.KeySearchFailed) }
		</p>
	} else if s.HasResults() {
		<ul class="search__list" aria-label={ p.Text(viewmodel.KeySearchResultsFor, viewmodel.PlaceholderQuery, s.Query) }>
			for _, r := range s.Results {
				@SearchResultItem(p, r)
			}
		</ul>
	} else if s.FoundNothing() {
		<p class="search__empty mb-0" role="status">
			{ p.Text(viewmodel.KeySearchEmpty, viewmodel.PlaceholderQuery, s.Query) }
		</p>
	}
	// Nothing typed yet renders nothing at all. An empty container with a
	// prompt in it is a thing that has to be dismissed.
}

// SearchResultItem is one film to pick.
//
// The whole row is one link rather than a row with a button in the corner:
// there is exactly one thing you can do with a search result, and a 44px tap
// target that happens to be the size of the poster is much easier to hit on a
// phone than a button beside it.
templ SearchResultItem(p Page, r viewmodel.SearchResult) {
	<li class="search__item">
		<a class="search__pick" href={ r.PickHref } aria-label={ p.Text(viewmodel.KeySearchPick, viewmodel.PlaceholderTitle, r.Title) }>
			if r.HasPoster() {
				// Remote, hotlinked, and referrer-stripped. See the note at
				// the top of this file before changing any of the three.
				//
				// Width and height are set so the row does not jump as the
				// posters arrive; they are the CSS box, not the file's own
				// dimensions, and the aspect ratio is TMDB's standard 2:3.
				<img
					class="search__poster"
					src={ r.PosterURL }
					alt=""
					width="92"
					height="138"
					loading="lazy"
					decoding="async"
					referrerpolicy="no-referrer"
				/>
			} else {
				// A placeholder rather than nothing, so a film with no poster
				// keeps the row's shape. aria-hidden because the link already
				// has an accessible name and "no poster" twice is noise.
				<span class="search__poster search__poster--empty" aria-hidden="true">
					{ p.Text(viewmodel.KeySearchNoPoster) }
				</span>
			}
			<span class="search__meta">
				<span class="search__title">{ r.Label }</span>
				if r.HasOverview() {
					<span class="search__overview">{ r.Overview }</span>
				}
			</span>
		</a>
	</li>
}

// PickedFilm is the chosen film, shown above the form.
//
// It exists because a form that fills itself in is indistinguishable from a
// bug the first time somebody sees it. This says, in one row with the poster
// they just clicked, "this is the film that is about to go on the board" — and
// carries the way back out beside it.
templ PickedFilm(p Submit) {
	if p.Picked.IsSet() {
		<div class="panel picked">
			<p class="badge badge--accent">{ p.Layout.Text(viewmodel.KeySearchPicked) }</p>
			<div class="picked__row">
				if p.Picked.HasPoster() {
					<img
						class="picked__poster"
						src={ p.Picked.PosterURL }
						alt=""
						width="92"
						height="138"
						loading="lazy"
						decoding="async"
						referrerpolicy="no-referrer"
					/>
				}
				<div class="picked__meta">
					<p class="picked__title mb-0"><strong>{ p.Picked.Label }</strong></p>
					if p.Picked.ClearHref != "" {
						// The escape hatch, and it is not decoration: this
						// group submits films TMDB has never heard of, and a
						// picker you cannot back out of is worse than the four
						// boxes it replaced.
						<a class="btn btn--ghost" href={ p.Picked.ClearHref }>
							{ p.Layout.Text(viewmodel.KeySearchClear) }
						</a>
					}
				</div>
			</div>
		</div>
	}
}
