package templates

// MovieCardItem is one submission as a card, for a <ul class="card-grid">.
//
// The same card serves the slate and the "what you already have up" list on
// the submit page, because they are the same thing seen from two places. Two
// near-identical cards is how one of them quietly stops showing the trailer.
//
// Every shape a movie row comes in is handled here rather than at the call
// sites: no year, no description, no trailer, a trailer that cannot be
// embedded, a blank submitter name, a title long enough to overflow the card.
// base.css does the last one — .card__title sets overflow-wrap: anywhere and
// .card sets min-inline-size: 0 so a grid child is allowed to shrink — which
// is why nothing here truncates a title. A film's name is not decoration.
templ MovieCardItem(m MovieCard) {
	<li class="card">
		if m.CanEmbedTrailer() {
			// loading="lazy" is not a micro-optimisation here. A full slate is
			// six of these, and six eager players on a phone on the group
			// chat's data plan is most of a megabyte before anybody has
			// pressed anything. The 16:9 box is reserved by base.css either
			// way, so nothing moves when they load.
			<div class="card__media">
				<iframe
					src={ m.TrailerEmbedURL }
					title={ "Trailer: " + m.Title }
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
					allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			</div>
		}
		<h3 class="card__title">
			if m.Hidden {
				// Struck through rather than dropped: a withdrawn film that
				// simply vanishes from an admin list is how an admin comes to
				// believe it is still on the public slate.
				<s>{ m.TitleLine() }</s>
			} else {
				{ m.TitleLine() }
			}
		</h3>
		<p class="card__meta">
			if m.IsWinner {
				<span class="badge badge--accent">Winner</span>
			}
			if m.Hidden {
				<span class="badge">Withdrawn</span>
			}
			<span>Submitted by { m.SubmitterLabel() }</span>
		</p>
		if m.HasDescription() {
			<p class="card__body">{ m.Description }</p>
		}
		if m.HasTrailer() && !m.CanEmbedTrailer() {
			// The common case: most trailer links are not YouTube watch URLs
			// and have no embed form at all. A link is the answer, never an
			// empty player.
			<div class="card__actions">
				<a
					class="btn btn--ghost"
					href={ m.TrailerURL }
					target="_blank"
					rel="noopener noreferrer"
				>
					Watch the trailer
					// Six cards means six links reading "Watch the trailer" in
					// a screen reader's link list. The film's name is what
					// tells them apart, and the new tab is worth warning about
					// before it happens rather than after.
					<span class="visually-hidden">
						{ " for " + m.Title + " (opens in a new tab)" }
					</span>
				</a>
			</div>
		}
	</li>
}
