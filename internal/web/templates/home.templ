package templates

import "github.com/ERaith/nightofathousandpixels/internal/web/viewmodel"

// HomePage is the placeholder front page.
//
// It is a placeholder in the sense that no data reaches it yet — there is no
// countdown, no slate and no sign-in button, because none of those exist. It
// is not a placeholder in the sense of being provisional markup: the shape
// here (page-head, a status notice, the three-step card grid, an empty state
// for the archive) is what the real front page grows into once D1 knows the
// season window and E4 has a slate to show.
//
// Everything on it is built out of base.css's own vocabulary, so it inherits
// the 320px behaviour rather than re-deriving it: .card-grid collapses to one
// column, .measure keeps the prose at a readable width, and nothing has a
// fixed width that could push the page sideways.
//
// Every visible string is a copy key. That is not indirection for its own
// sake: the front page is the whole of what most of the thirty people see
// before October, and it is where a pack either establishes a voice or does
// not. See viewmodel/copy.go.
templ HomePage(p Page) {
	@Layout(p) {
		<div class="page-head measure">
			if label := p.SeasonLabel(); label != "" {
				<p class="badge badge--accent">{ label }</p>
			}
			<h1>{ p.Theme.Resolve().SiteTitle }</h1>
			<p class="lead">{ p.Text(viewmodel.KeyHomeLead) }</p>
		</div>
		<div class="notice notice--warn" role="status">
			<p class="mb-0">
				<strong>{ p.Text(viewmodel.KeyHomeNoticeLede) }</strong>
				{ " " }
				{ p.Text(viewmodel.KeyHomeNoticeBody) }
			</p>
		</div>
		<section>
			<h2>{ p.Text(viewmodel.KeyHomeStepsHeading) }</h2>
			<ol class="card-grid">
				<li class="card">
					<p class="card__meta"><span class="badge">{ p.Text(viewmodel.KeyHomeStep1Badge) }</span></p>
					<h3 class="card__title">{ p.Text(viewmodel.KeyHomeStep1Title) }</h3>
					<p class="card__body">{ p.Text(viewmodel.KeyHomeStep1Body) }</p>
				</li>
				<li class="card">
					<p class="card__meta"><span class="badge">{ p.Text(viewmodel.KeyHomeStep2Badge) }</span></p>
					<h3 class="card__title">{ p.Text(viewmodel.KeyHomeStep2Title) }</h3>
					<p class="card__body">{ p.Text(viewmodel.KeyHomeStep2Body) }</p>
				</li>
				<li class="card">
					<p class="card__meta"><span class="badge">{ p.Text(viewmodel.KeyHomeStep3Badge) }</span></p>
					<h3 class="card__title">{ p.Text(viewmodel.KeyHomeStep3Title) }</h3>
					<p class="card__body">{ p.Text(viewmodel.KeyHomeStep3Body) }</p>
				</li>
			</ol>
		</section>
		<section class="measure">
			<h2>{ p.Text(viewmodel.KeyHomeArchiveHead) }</h2>
			<div class="empty">
				<p class="mb-0">{ p.Text(viewmodel.KeyHomeArchiveEmpty) }</p>
			</div>
		</section>
	}
}
