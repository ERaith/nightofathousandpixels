package templates

import "github.com/ERaith/nightofathousandpixels/internal/web/viewmodel"

// SubmitPage is the form for putting a movie on the board.
//
// There are two whole versions of this page and no half-version: either the
// form is here, or it is not and the page says why. The form is never
// rendered disabled. A disabled form is something people fill in anyway —
// they tab into it, they type, and only the submit button tells them no — and
// on a phone it is not even visibly disabled until you try.
//
// Which version to show is SubmitPage.CanSubmit, decided by the handler from
// the season window, membership and the quota together. This template never
// assembles that. What it does decide is the wording, in submitBlockedCopy.
templ SubmitPage(p Submit) {
	@Layout(p.Layout) {
		<div class="page-head measure">
			if label := p.Season.Label(); label != "" {
				<p class="badge">{ label }</p>
			}
			// The heading and the lead are copy KEYS rather than fixed
			// ones, because the same page is also the edit form (ticket
			// E3): HeadingCopyKey answers the submit wording unless a
			// handler asked for the other. Neither branch can supply words
			// of its own -- a pack still owns both sentences.
			<h1>{ p.Layout.Text(p.HeadingCopyKey()) }</h1>
			// The lead is instructions for filling the form in, so it goes
			// when the form does. A page that explains how to do a thing and
			// then says you cannot do it is a page that was not read back.
			if p.CanSubmit && p.Action != "" {
				<p class="lead">{ p.Layout.Text(p.LeadCopyKey()) }</p>
			}
		</div>
		if p.CanSubmit && p.Action != "" {
			// The picker comes before the form, because searching is now the
			// way this page is meant to be used and the four boxes are the
			// fallback. Both render nothing when they have nothing to say —
			// no TMDB key means no search box, nothing picked means no
			// summary — so a stack with no key gets exactly the page it
			// always had.
			@SearchSection(p)
			@PickedFilm(p)
			@SubmitFormSection(p)
		} else {
			@SubmitBlockedSection(p)
		}
		// The withdraw form sits BELOW the edit form and outside it, which
		// is the whole reason it is a second <form> rather than a second
		// button: one form cannot post to two places, and two submit buttons
		// in one form means the Enter key in the title field decides which
		// one fires. On this page the wrong one takes a film off the board.
		//
		// It is last on the page for the same reason it is styled quietly:
		// the common visit here is an edit, and the destructive control
		// should not be the thing the thumb lands on first at 320px.
		if p.CanWithdraw() {
			@SubmitWithdrawSection(p)
		}
		if len(p.Existing) > 0 {
			<section>
				<h2>
					{ p.Layout.Text(viewmodel.KeySubmitExistingHead,
						viewmodel.PlaceholderCount,
						p.Layout.Count(len(p.Existing), viewmodel.KeyFilmOne, viewmodel.KeyFilmMany)) }
				</h2>
				<ul class="card-grid">
					for _, movie := range p.Existing {
						@MovieCardItem(p.Layout.Theme, movie)
					}
				</ul>
			</section>
		}
	}
}

// SubmitFormSection is the form itself.
//
// Every control is labelled by a real <label for>, described by a hint, and —
// when it has gone wrong — described by its error too, through
// aria-describedby. Colour is never the only signal: the message is text,
// beside the field, in the field's own order.
//
// Native validation is left on. base.css styles :user-invalid, which only
// fires once somebody has actually had a go at a field, so the browser's own
// check is the first line and the server's is the one that counts. Nothing
// here depends on JavaScript being present.
templ SubmitFormSection(p Submit) {
	{{ fields := newSubmitFields(p.Layout.Theme, p.Form) }}
	<div class="measure stack">
		// The summary is an alert about the form and sits OUTSIDE it, above,
		// where it reads first. The form itself is one panel rather than a
		// run of controls down the page: nap-luo's "a single confident moment
		// rather than a form" is mostly this, a surface with an edge round it
		// so that four fields and a button read as one object you are filling
		// in and not as four things you have to get through.
		@SubmitErrorSummary(p.Layout.Theme, fields)
		if p.Search.Available && !p.Form.FromTMDB() {
			// The bridge between the picker and the boxes. It only appears
			// when there is a picker to have failed you: on a stack with no
			// TMDB key the form below IS the way to submit, and announcing it
			// as a fallback would be describing a feature that is not there.
			<h2 class="h3 mb-0">{ p.Layout.Text(viewmodel.KeySearchManual) }</h2>
		}
		<form class="panel" method="post" action={ p.Action }>
			// Your allowance, at the top of the thing it constrains. It was a
			// line of grey body text before, which is where the eye goes last.
			if label := p.Quota.Label(); label != "" {
				<p class="badge badge--accent">{ label }</p>
			}
			if p.Form.FromTMDB() {
				// The chosen film's id, and the ONLY thing on this form the
				// server takes back from the browser. Title, year and trailer
				// are looked up from it again on POST, so a tampered value
				// here submits a different real film rather than a forged one
				// — see board.handleSubmitPost.
				<input type="hidden" name={ viewmodel.FieldTMDBID } value={ p.Form.TMDBID }/>
			}
			@formRow(fields.Title) {
				// readonly, not disabled, when the film came from TMDB. The
				// server is going to overwrite this from TMDB whatever is in
				// the box, and a box you can type into that silently discards
				// what you typed is the worst of the three options. readonly
				// still posts, still reads to a screen reader, and still shows
				// the value; "Not this one" above is how you get a box back.
				<input
					type="text"
					id={ fields.Title.ID }
					name={ fields.Title.Name }
					value={ fields.Title.Value }
					required
					autocomplete="off"
					readonly?={ p.Form.FromTMDB() }
					aria-invalid={ fields.Title.AriaInvalid() }
					aria-describedby={ fields.Title.DescribedBy() }
				/>
			}
			@formRow(fields.Year) {
				// Text rather than number: the view model keeps what the
				// person typed, so "nineteen eighty four" has to have
				// somewhere to go on the way back. inputmode gets the digits
				// keyboard on a phone without the spinner and the scroll-wheel
				// accidents that come with type="number".
				<input
					type="text"
					id={ fields.Year.ID }
					name={ fields.Year.Name }
					value={ fields.Year.Value }
					inputmode="numeric"
					pattern="[0-9]{4}"
					autocomplete="off"
					readonly?={ p.Form.FromTMDB() }
					aria-invalid={ fields.Year.AriaInvalid() }
					aria-describedby={ fields.Year.DescribedBy() }
				/>
			}
			@formRow(fields.TrailerURL) {
				<input
					type="url"
					id={ fields.TrailerURL.ID }
					name={ fields.TrailerURL.Name }
					value={ fields.TrailerURL.Value }
					inputmode="url"
					autocomplete="off"
					spellcheck="false"
					placeholder="https://"
					readonly?={ p.Form.FromTMDB() }
					aria-invalid={ fields.TrailerURL.AriaInvalid() }
					aria-describedby={ fields.TrailerURL.DescribedBy() }
				/>
			}
			@formRow(fields.Description) {
				<textarea
					id={ fields.Description.ID }
					name={ fields.Description.Name }
					rows="4"
					aria-invalid={ fields.Description.AriaInvalid() }
					aria-describedby={ fields.Description.DescribedBy() }
				>{ fields.Description.Value }</textarea>
			}
			<div class="form-actions">
				<button class="btn btn--primary" type="submit">{ p.Layout.Text(p.ButtonCopyKey()) }</button>
				if p.CancelHref != "" {
					<a class="btn btn--ghost" href={ p.CancelHref }>{ p.Layout.Text(viewmodel.KeySubmitCancel) }</a>
				}
			</div>
		</form>
	</div>
}

// SubmitErrorSummary is the list of what needs fixing, above the form.
//
// It is what makes a rejected form recoverable for somebody who cannot see the
// red (WCAG 3.3.1): each entry names its field and links straight to the
// control, and base.css's :target rule leaves room above it when the link is
// followed. The summary reads down the form in the form's own order.
//
// It renders nothing at all when the form is clean, rather than an empty
// container, because the container is a child of a .stack and would otherwise
// take a gap for saying nothing.
templ SubmitErrorSummary(t Theme, fields submitFields) {
	if bad := fields.Invalid(); len(bad) > 0 {
		<div class="notice notice--error" id="submit-errors" tabindex="-1" role="alert">
			<div>
				<p class="mt-0">
					<strong>
						{ t.Text(viewmodel.KeySubmitErrorsHeading,
							viewmodel.PlaceholderCount,
							t.Count(len(bad), viewmodel.KeyThingOne, viewmodel.KeyThingMany)) }
					</strong>
				</p>
				<ul class="mb-0">
					for _, field := range bad {
						<li>
							<a href={ field.ErrorHref() }>{ field.Label }</a>
							{ " — " + field.Error }
						</li>
					}
				</ul>
			</div>
		</div>
	}
}

// SubmitBlockedSection is what the page says in place of the form.
//
// It offers the way back to the slate and nothing else. There is deliberately
// no submit control here in any shape — not greyed out, not "try anyway" —
// because every one of these cases is a no that the handler has already made
// and the database would enforce again underneath it.
templ SubmitBlockedSection(p Submit) {
	{{ blocked := submitBlockedCopy(p.Layout.Theme, p) }}
	<section class="measure">
		<h2>{ blocked.Heading }</h2>
		<p class="lead">{ blocked.Body }</p>
		if p.CancelHref != "" {
			<div class="cluster">
				<a class="btn btn--primary" href={ p.CancelHref }>{ p.Layout.Text(viewmodel.KeySubmitBack) }</a>
			</div>
		}
	</section>
}

// formRow wraps one control in its label, its hint and its error message.
//
// The control itself is the caller's, passed as children, because a year and a
// description are not the same input and pretending otherwise ends in a
// configuration struct with eight fields nobody can read. What is shared is
// the part that has to be identical every time: the label pointing at the
// control, and the ids the control points back at. See formField.
//
// Order in the DOM is order on screen — .field is a column flexbox — so the
// message appears under the control it is about.
templ formRow(f formField) {
	<div class="field">
		<label for={ f.ID }>{ f.Label }</label>
		if f.Hint != "" {
			<p class="field__hint mb-0" id={ f.HintID() }>{ f.Hint }</p>
		}
		{ children... }
		if f.Invalid() {
			<p class="field__error mb-0" id={ f.ErrorID() }>{ f.Error }</p>
		}
	</div>
}

// SubmitWithdrawSection is the "take it back off the board" control on the
// edit page.
//
// It says out loud what withdrawing actually does, because the mental model it
// replaces is "delete" and that model is wrong in a way people care about: the
// film leaves the slate, the pick comes back, and anybody who already ranked
// it keeps their ballot. None of that is guessable from a button.
//
// The heading is an h2 and the section has its own landmark, so somebody
// navigating by heading finds it rather than discovering it by tabbing past
// the save button.
templ SubmitWithdrawSection(p Submit) {
	<section class="measure" id="withdraw" aria-labelledby="withdraw-heading">
		<h2 id="withdraw-heading">{ p.Layout.Text(viewmodel.KeyWithdrawHeading) }</h2>
		<p>{ p.Layout.Text(viewmodel.KeyWithdrawBody) }</p>
		<form method="post" action={ p.WithdrawAction }>
			<button class="btn btn--danger" type="submit">{ p.Layout.Text(viewmodel.KeyWithdrawButton) }</button>
		</form>
	</section>
}
